# ============================================================================
# War On Nations — environment variables
# Copy to .env and fill in real values. Never commit real secrets.
# ============================================================================

# --- Database -----------------------------------------------------------
# Postgres connection string (any one of these is accepted, checked in order)
DATABASE_URL=postgres://user:password@host:5432/dbname
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL_UNPOOLED=

# --- Telegram -------------------------------------------------------------
# Bot token from @BotFather, used to verify Telegram login and send notifications
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-your-bot-token

# --- Session ----------------------------------------------------------------
# Long random secret (>= 32 chars) used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-string
NODE_ENV=development

# --- Admin ------------------------------------------------------------------
# Comma-separated list of wallet addresses allowed into the admin panel
ADMIN_WALLETS=

# --- Cron / internal jobs ---------------------------------------------------
# Shared secret required by the scheduled tick endpoint
CRON_SECRET=replace-with-a-random-string

# --- TON network / payments -------------------------------------------------
# VITE_ variables are exposed to the browser bundle — no secrets here.
VITE_TON_NETWORK=mainnet
TON_NETWORK=mainnet
# Leave empty to run payments in MOCK mode (no real transfers required)
VITE_TON_TREASURY_ADDRESS=
TON_TREASURY_ADDRESS=
VITE_TON_PAYMENTS_ENABLED=false
# API key for the TON indexer (tonapi.io) used to verify payments and read
# the live Claim Treasury jetton balances. Optional (public tier works).
TON_API_KEY=

# --- Claim Treasury (on-chain payouts) --------------------------------------
# Set to "true" once the ClaimTreasury contract is deployed and funded.
CLAIM_ONCHAIN_LIVE=false
CLAIM_TREASURY_ADDRESS=
VITE_CLAIM_TREASURY_ADDRESS=
# Ed25519 keypair used to sign claim authorizations (server-only private key)
CLAIM_SIGNER_PRIVATE_KEY=
CLAIM_SIGNER_PUBLIC_KEY=
VITE_CLAIM_SIGNER_PUBLIC_KEY=
# Deploy scripts only (contracts/, scripts/) — never set in the app runtime
OWNER_MNEMONIC=

# --- Treasury local overrides (development only) ----------------------------
# When set, these replace the live on-chain jetton balance reads so you can
# simulate Green/Yellow/Red/Critical economy zones without touching chain.
TREASURY_MOCK_WARDOG=
TREASURY_MOCK_WARCAT=

# --- Monitoring (Sentry, no SDK — HTTP envelope API) ------------------------
# Browser build-time DSN (exposed to the client bundle)
VITE_SENTRY_DSN=https://public_key@o0.ingest.sentry.io/0
# Server-side DSN, read at request time (can be the same DSN)
SENTRY_DSN=https://public_key@o0.ingest.sentry.io/0
# Release/version tag attached to captured events
VITE_APP_VERSION=0.0.0

# --- Analytics (PostHog, no SDK — HTTP capture API) -------------------------
VITE_POSTHOG_KEY=phc_your_project_key
VITE_POSTHOG_HOST=https://eu.i.posthog.com
